{
  "feeds": [
    {
      "name": "Some Blog",
      "url": "https://example.com/rss",
      "type": "regular",
      "max_age_hours": 24,
      "message_template": "📰 {title}\n\n{description}\n\n{link}",
      "title_excludes": ["sponsored", "newsletter roundup"]
    },
    {
      "name": "Some Podcast",
      "url": "https://example.com/podcast.rss",
      "type": "podcast",
      "max_age_days": 7,
      "extract": {
        "episode_id": { "from": "link", "pattern": "/file/[^/]+/(\\d+)/" }
      },
      "preview_url": "https://example.com/listen/{episode_id}",
      "preview_title": "🎧 {title}",
      "title_contains": ["interview", "special"]
    }
  ]
}
