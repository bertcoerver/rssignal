# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# Sender account: the Signal number rssignal sends from, in E.164 format
# (the account you linked with `rssignal link`).
RSSIGNAL_ACCOUNT=+31600000000

# Default recipient for `rssignal send` / `send_msg` when none is given
# explicitly. A phone number in E.164 format, or a group id. Optional.
# `rssignal run` ignores this: each feed sends to the group named after it.
RSSIGNAL_RECIPIENT=+31600000000

# Where full tracebacks are appended when a feed fails. Optional; defaults to
# `rssignal.log` in the directory you run from — next to this file. Handy to
# point somewhere fixed if you run from a scheduler or an Apple Shortcut, since
# stderr goes nowhere there. Rotated to `.1` once it passes 1 MB.
# RSSIGNAL_LOG=/Users/you/Library/Logs/rssignal.log

# The library fetchit downloads into, which is where every feed's items come
# from. Optional; defaults to ~/fetchit.
# RSSIGNAL_LIBRARY=~/fetchit
