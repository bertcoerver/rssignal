# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# Sender account: the Signal number rssignal sends from, in E.164 format
# (the account you linked with `rssignal link`).
RSSIGNAL_ACCOUNT=+31600000000

# Default recipient for `rssignal send` / `send_msg` when none is given
# explicitly. A phone number in E.164 format, or a group id. Optional.
# `rssignal run` ignores this: each feed sends to the group named after it.
RSSIGNAL_RECIPIENT=+31600000000

# Only if YouTube starts answering "Sign in to confirm you're not a bot".
# Hands yt-dlp a signed-in session, either from a browser you are logged into
# (a name, optionally `browser:profile`) or from a cookies.txt export. Set one;
# the file wins if you set both. Use a throwaway Google account — these are live
# credentials. Both optional and off by default.
# RSSIGNAL_YOUTUBE_COOKIES_FROM_BROWSER=firefox
# RSSIGNAL_YOUTUBE_COOKIES=~/.config/rssignal/youtube-cookies.txt
